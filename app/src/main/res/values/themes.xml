<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Start-up window colour, so there's no flash before Compose draws. Light version;
         values-night/themes.xml has the dark one. The in-app theme choice takes over after. -->
    <style name="Theme.ChromaNoise" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
</resources>
